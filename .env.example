# Copy to .env and adjust. All values shown are the defaults.
LLM_MODEL=qwen2.5:7b               # any model you have pulled in Ollama (llama3.1:8b, qwen2.5:14b, ...)
OLLAMA_HOST=http://localhost:11434
EMBEDDING_BACKEND=st               # st = sentence-transformers | hash = offline fallback (weak, for tests)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MOCK_LLM=0                         # 1 = deterministic canned LLM (tests/demo without Ollama)
DATA_DIR=./data
API_BASE_URL=http://localhost:8000 # used by the Streamlit UI
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=180
OCR_ENABLED=1
CHUNK_MAX_WORDS=350
CHUNK_OVERLAP_WORDS=40
MAX_UPLOAD_MB=50
# MIN_SIMILARITY / CONF_HIGH / CONF_MEDIUM default per embedding backend; override after benchmarking.
LOG_LEVEL=INFO
