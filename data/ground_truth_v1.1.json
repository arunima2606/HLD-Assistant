    },
    {
      "component": "LightingController",
      "name": "PowerStatePort",
      "direction": "required",
      "interface": "IPowerState"
    },
    {
      "component": "PowerManager",
      "name": "PowerStateOut",
      "direction": "provided",
      "interface": "IPowerState"
    },
    {
      "component": "DiagnosticHandler",
